# Copiez ce fichier en .env et remplissez les valeurs.

DATABASE_URL="postgresql://..."

# Administration
ADMIN_PASSWORD="..."
ADMIN_SESSION_SECRET="min-16-caracteres-aleatoires"

# Session participants (optionnel — sinon ADMIN_SESSION_SECRET)
# PARTICIPANT_SESSION_SECRET="..."

# URL publique du site (liens dans les e-mails)
NEXT_PUBLIC_SITE_URL="https://www.missionagape-tg.com"

# E-mails — SMTP (mail.com, Gmail, etc.)
# mail.com : SMTP_HOST=smtp.mail.com, SMTP_PORT=587
# Gmail    : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 + mot de passe d'application Google
SMTP_HOST="smtp.mail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="agapemission2014@mail.com"
SMTP_PASS="votre-mot-de-passe-application"
SMTP_FROM="agapemission2014@mail.com"

# Adresse qui reçoit les alertes admin (nouvelle inscription)
ADMIN_NOTIFY_EMAIL="agapemission2014@mail.com"

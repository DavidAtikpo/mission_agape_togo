# Neon (ou autre PostgreSQL) — URL du tableau de bord Neon (connexion pooled recommandée)
# Ne commitez jamais de vrai mot de passe ; copiez ce fichier vers .env
# Optionnel : uselibpqcompat=true évite l’avertissement Node « sslmode=require » avec le driver pg (voir lib/prisma.ts qui l’ajoute si absent).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true"

# Admin — /admin/login
ADMIN_PASSWORD="changez-moi-en-production"
ADMIN_SESSION_SECRET="generez-une-chaine-longue-aleatoire-min-16"

# Formation The Code² — sessions participants (optionnel, sinon ADMIN_SESSION_SECRET est réutilisé)
CODE2_SESSION_SECRET="generez-une-autre-chaine-longue-aleatoire"
